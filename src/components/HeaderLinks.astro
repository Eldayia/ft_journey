---
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';

const services = [
  { label: 'Cloud', href: 'https://cloud.camjouan.tech' },
  { label: 'Hastebin', href: 'https://paste.camjouan.tech' },
  { label: 'Excalidraw', href: 'https://draw.camjouan.tech' },
  { label: 'ConvertX', href: 'https://convert.camjouan.tech' },
  { label: 'Upload', href: 'https://transfer.camjouan.tech' },
  { label: 'StirlingPDF', href: 'https://pdf.camjouan.tech' },
];
---

<SocialIcons><slot /></SocialIcons>
<details class="portal-menu">
  <summary>Portal</summary>
  <nav aria-label="Services du portail">
    <a href="/portail/">Mes services</a>
    {services.map(({ label, href }) => (
      <a href={href} target="_blank" rel="noopener noreferrer">{label}</a>
    ))}
  </nav>
</details>

<script>
  document.addEventListener('click', (event) => {
    document.querySelectorAll<HTMLDetailsElement>('.portal-menu[open]').forEach((menu) => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    document.querySelectorAll<HTMLDetailsElement>('.portal-menu[open]').forEach((menu) => {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    });
  });
</script>

<style>
  .portal-menu {
    position: relative;
    font-size: 1rem;
  }

  summary {
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 0.375rem;
    color: var(--sl-color-text-accent);
    font-weight: 600;
  }

  summary:hover,
  .portal-menu[open] summary {
    background: var(--sl-color-gray-6);
  }

  nav {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 0.5rem);
    z-index: 10;
    width: 13rem;
    max-width: calc(100vw - 2rem);
    max-height: calc(100dvh - var(--sl-nav-height) - 2rem);
    overflow-y: auto;
    padding: 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg-nav);
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.15);
  }

  a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 0.25rem;
    color: var(--sl-color-text);
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-text-accent);
  }

  a:first-child {
    margin-bottom: 0.25rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    border-radius: 0;
  }
</style>
